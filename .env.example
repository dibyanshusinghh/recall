# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (shared PostgreSQL instance with Notify service) ────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/shared_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# HS256 shared secret — the Notify Spring Boot service can verify Recall JWTs
# using this same value. For production, consider RS256 with a keypair instead:
#   JWT_PRIVATE_KEY_PATH=./keys/private.pem
#   JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Token encryption (AES-256-GCM) ──────────────────────────────────────────
# Must be exactly 64 hex characters (= 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string_0000000000000000000000000000000000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Tier 2: Google Workspace / Gemini features ───────────────────────────────
# Set to true only when the connected account has Google Workspace with Gemini.
# All Tier-1 booking/reschedule/cancel still works when this is false.
WORKSPACE_FEATURES_ENABLED=false

# Required only when WORKSPACE_FEATURES_ENABLED=true:
GOOGLE_PROJECT_ID=your_gcp_project_id
PUBSUB_TOPIC_NAME=meeting-events
PUBSUB_SUBSCRIPTION_NAME=meeting-events-push-sub
# Audience for verifying Google's OIDC token on the Pub/Sub push endpoint.
# Typically the full URL of your POST /webhooks/pubsub/meeting-events endpoint.
GOOGLE_PUBSUB_AUDIENCE=https://your-domain.com/webhooks/pubsub/meeting-events

# ─── Slot-hold TTL ────────────────────────────────────────────────────────────
# How long a slot hold lasts in Redis before it expires (seconds). Default: 600 (10 min).
SLOT_HOLD_TTL_SECONDS=600

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── Sentry (optional) ───────────────────────────────────────────────────────
# Leave unset in local dev — the SDK no-ops gracefully when DSN is absent.
# Set to your project's DSN in staging/production for error monitoring.
SENTRY_DSN=
