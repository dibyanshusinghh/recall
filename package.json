{
  "name": "recall",
  "version": "1.0.0",
  "description": "Google Calendar booking backend with Workspace/Gemini artifact support",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate up --migrations-dir migrations",
    "db:migrate:down": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate down --migrations-dir migrations",
    "db:migrate:redo": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate redo --migrations-dir migrations",
    "db:migrate:status": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate status --migrations-dir migrations",
    "test": "echo \"Tests not yet configured\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.1",
    "bullmq": "^6.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "morgan": "^1.11.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
